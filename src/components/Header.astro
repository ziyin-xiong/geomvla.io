---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url: string;
  name: string;
  icon?: string;
};

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  subtitle?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, authors, conference, subtitle, notes, links } = Astro.props;

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-12 overflow-hidden border-b border-zinc-900/10",
    hasBackground ? "min-h-[calc(100svh-5.5rem)] pt-28 pb-24" : "pt-8 pb-12",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(12,12,12,0.62),rgba(12,12,12,0.36)_42%,rgba(12,12,12,0.70))]" />
      </div>
    )
  }
  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-[58rem] flex-col items-center px-6 text-center",
      hasBackground
        ? "gap-5 text-white prose-headings:text-white [text-shadow:0_1px_12px_rgba(0,0,0,0.45)]"
        : "gap-4 text-zinc-900 dark:text-white",
    ]}
  >
    {conference && <div class:list={["not-prose rounded-full px-4 py-1 text-sm font-medium uppercase tracking-[0.12em] backdrop-blur-sm", hasBackground ? "border border-white/30 bg-white/20 text-white" : "border border-zinc-300 bg-white/70 text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900/70 dark:text-white"]}>{conference}</div>}
    <h1 class="my-0 max-w-[54rem] text-5xl font-semibold leading-tight md:text-6xl">{title}</h1>
    {subtitle && <p class:list={["not-prose m-0 max-w-3xl text-base leading-snug md:text-lg", hasBackground ? "text-white/90" : "text-zinc-700 dark:text-white/90"]}>{subtitle}</p>}
    <div class:list={["flex flex-row flex-wrap justify-center gap-x-6 gap-y-2", hasBackground ? "text-white/90" : "text-zinc-800 dark:text-white/90"]}>
      {
        authors.map((author) => (
          <div class="flex flex-col items-center text-center">
            <div class="flex flex-row text-lg">
              {author.url ? (
                <a class:list={[hasBackground ? "not-prose text-white underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-white" : "not-prose text-zinc-900 underline decoration-zinc-300 underline-offset-4 hover:text-emerald-800 hover:decoration-emerald-700 dark:text-white dark:decoration-white/30 dark:hover:text-emerald-300 dark:hover:decoration-emerald-300"]} href={author.url}>{author.name}</a>
              ) : (
                author.name
              )}
              {author.notes && (
                <sup class="text-base">
                  {author.notes.map(
                    (note, index, array) =>
                      note + (index < array.length - 1 ? "," : ""),
                  )}
                </sup>
              )}
            </div>
            {author.institution && <div>{author.institution}</div>}
          </div>
        ))
      }
    </div>
    {
      notes && (
        <div class:list={["text-center text-sm", hasBackground ? "text-white/80" : "text-zinc-600 dark:text-white/75"]}>
          {
            // prettier-ignore
            notes.map((note, index, array) => (
              <span>
                <sup>{note.symbol}</sup>{note.text}{index < array.length - 1 ? "," : ""}
              </span>
            ))
          }
        </div>
      )
    }
    {
      links && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-3 pt-2">
          {links.map((link) => (
            <a
              href={link.url}
              class:list={["flex flex-row items-center gap-2 rounded-full px-5 py-2 text-base font-medium transition hover:no-underline",
                hasBackground ? "bg-white/95 hover:bg-white text-zinc-900 text-shadow-none shadow-lg shadow-black/20" : "bg-zinc-800 text-white hover:bg-black dark:text-zinc-900 dark:hover:bg-zinc-50 dark:bg-zinc-200"
              ]}
            >
              {link.icon && <Icon name={link.icon} />}
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
    box-shadow: none;
  }
</style>
