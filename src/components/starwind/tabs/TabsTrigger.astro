---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

interface Props extends Omit<HTMLAttributes<"button">, "type" | "id" | "role"> {
  value: string;
}

export const tabsTrigger = tv({
  base: [
    "inline-flex items-center justify-center gap-2 rounded-full border border-transparent px-3.5 py-1.5 font-normal whitespace-nowrap transition-[background-color,color,border-color]",
    "text-zinc-600 data-[state=active]:border-zinc-300 data-[state=active]:bg-[#eef1e8] data-[state=active]:text-zinc-950 hover:bg-zinc-100 hover:text-zinc-950 hover:data-[state=active]:bg-[#e4e9dc]",
    "dark:data-[state=active]:bg-zinc-700 hover:dark:bg-zinc-600 hover:dark:data-[state=active]:bg-zinc-600",
    "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
    "focus-visible:border-outline focus-visible:ring-outline/50 focus-visible:outline-outline focus-visible:ring-3 focus-visible:outline-1",
    "disabled:pointer-events-none disabled:opacity-50",
  ],
});

const { value, class: className, ...rest } = Astro.props;
---

<button
  class={tabsTrigger({ class: className })}
  data-slot="tabs-trigger"
  data-tabs-trigger
  data-value={value}
  data-state="inactive"
  role="tab"
  aria-selected="false"
  {...rest}
>
  <slot />
</button>
