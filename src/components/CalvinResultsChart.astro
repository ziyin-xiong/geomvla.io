    ariaLabel: "RoboTwin2.0 five-task average",
    caption: "Average success rate over five representative RoboTwin2.0 tasks.",
    minScore: 30,
    maxScore: 90,
    ticks: [90, 75, 60, 45, 30],
    digits: 1,
