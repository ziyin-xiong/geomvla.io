type Category = "3d" | "motion" | "other" | "ours";

type ChartResult = {
  method: string;
  score: number;
  category: Category;
  color: string;
  hoverColor: string;
};

type ResultChart = {
  id: string;
  title: string;
  ariaLabel: string;
  caption: string;
  minScore: number;
  maxScore: number;
  ticks: number[];
  digits: number;
  results: ChartResult[];
};

type LiberoMetric = "average" | "object" | "spatial" | "goal" | "long";

type LiberoMethod = {
  method: string;
  category: Category;
