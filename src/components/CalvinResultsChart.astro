<section class="not-prose mx-auto max-w-6xl" data-results-charts>
  <div class="mx-auto mb-5 flex max-w-[64rem] flex-wrap items-center justify-end gap-3 text-sm text-zinc-600 dark:text-zinc-300">
    <span class="inline-flex items-center gap-2">
        <span class="size-3 rounded-[3px] bg-[#9d9484]"></span>
      3D VLAs
    </span>
    <span class="inline-flex items-center gap-2">
        <span class="size-3 rounded-[3px] bg-[#6c7f8d]"></span>
      Motion-guided
    </span>
    <span class="inline-flex items-center gap-2">
        <span class="size-3 rounded-[3px] bg-[#8d8499]"></span>
      Other baselines
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="size-3 rounded-[3px] bg-[#329a68]"></span>
      GeomVLA and variants
    </span>
  </div>

  <div class="mx-auto grid max-w-6xl gap-7 lg:grid-cols-2">
    {
      topCharts.map((chart) => {
        const scoreRange = chart.maxScore - chart.minScore;
        return (
          <article class="mx-auto w-full max-w-[31rem]">
            <h3 class="mb-3 text-center font-mono text-lg font-semibold uppercase tracking-[0.1em] text-emerald-700 dark:text-emerald-300">
              {chart.title}
            </h3>

            <div class="relative rounded-sm border border-zinc-200/80 bg-white/45 px-3 pb-4 pt-5 shadow-sm shadow-zinc-900/5 dark:border-zinc-800 dark:bg-zinc-900/25">
              <div class="pointer-events-none absolute inset-x-3 bottom-20 top-5">
                {chart.ticks.map((tick) => (
                  <span
                    class="absolute inset-x-0 border-t border-zinc-200/80 dark:border-zinc-800"
                    style={`top: ${((chart.maxScore - tick) / scoreRange) * 100}%`}
                  ></span>
                ))}
              </div>

              <div class="grid min-h-[20rem] grid-cols-[2.25rem_minmax(0,1fr)] gap-2">
                <div class="relative mb-16 text-xs text-zinc-500 dark:text-zinc-400">
                  {chart.ticks.map((tick) => (
                    <span
                      class="absolute right-0 -translate-y-1/2"
                      style={`top: ${((chart.maxScore - tick) / scoreRange) * 100}%`}
                    >
                      {tick.toFixed(chart.digits === 3 ? 1 : 0)}
                    </span>
                  ))}
                </div>

                <div class="relative z-10 grid grid-cols-9 items-end gap-1.5 md:gap-2">
                  {chart.results.map((result, index) => (
                    <div
                      class="flex h-full min-w-0 flex-col justify-end"
                      style={`--score: ${result.score}; --min-score: ${chart.minScore}; --score-range: ${scoreRange}; --bar-color: ${result.color}; --bar-hover-color: ${result.hoverColor}; --delay: ${index * 70}ms;`}
                    >
                      <div class="flex h-[16rem] items-end">
                        <button
                          class="group result-bar relative w-full cursor-default rounded-t-[2px] bg-[var(--bar-color)] shadow-sm shadow-zinc-900/10 transition-colors duration-200 hover:bg-[var(--bar-hover-color)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
                          type="button"
                          aria-label={`${result.method}: ${result.score.toFixed(chart.digits)} on ${chart.ariaLabel}`}
                          data-result-bar
                        >
                          <span class="absolute -top-7 left-1/2 -translate-x-1/2 text-xs font-semibold text-zinc-800 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100 dark:text-zinc-100 md:opacity-100">
                            {result.score.toFixed(chart.digits)}
                          </span>
                        </button>
                      </div>
                      <div
                        class:list={[
                          "mt-3 h-12 text-center text-[0.62rem] leading-tight md:text-[0.68rem]",
                          result.category === "ours"
                            ? "font-bold text-emerald-800 dark:text-emerald-300"
                            : "font-medium text-zinc-700 dark:text-zinc-300",
                        ]}
                      >
                        {result.method}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <p class="mx-auto mt-3 max-w-lg text-center text-sm leading-snug text-zinc-600 dark:text-zinc-300">
              {chart.caption}
            </p>
          </article>
        );
      })
    }
  </div>

  <div class="mt-10" data-libero-chart>
    <div class="relative mx-auto mb-4 max-w-5xl text-center">
      <h3 class="m-0 font-mono text-lg font-semibold uppercase tracking-[0.1em] text-emerald-700 dark:text-emerald-300">
        LIBERO
      </h3>
      <div class="mt-3 flex flex-wrap justify-center gap-1.5 md:absolute md:right-0 md:top-1/2 md:mt-0 md:-translate-y-1/2" role="tablist" aria-label="LIBERO result metric">
        {
          liberoTabs.map((tab) => (
            <button
              class:list={[
                "rounded-sm border px-3 py-1.5 text-sm transition",
                tab.value === "average"
                  ? "border-zinc-300 bg-zinc-100 text-zinc-950 dark:border-zinc-600 dark:bg-zinc-800 dark:text-white"
                  : "border-transparent bg-transparent text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white",
              ]}
              type="button"
              role="tab"
              aria-selected={tab.value === "average" ? "true" : "false"}
              data-libero-tab={tab.value}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="relative mx-auto max-w-5xl rounded-sm border border-zinc-200/80 bg-white/45 px-3 pb-4 pt-10 shadow-sm shadow-zinc-900/5 dark:border-zinc-800 dark:bg-zinc-900/25">
      <div class="pointer-events-none absolute inset-x-3 bottom-20 top-[4.5rem]">
        {liberoTicks.map((tick) => (
          <span
            class="absolute inset-x-0 border-t border-zinc-200/80 dark:border-zinc-800"
            style={`top: ${((liberoMaxScore - tick) / liberoScoreRange) * 100}%`}
          ></span>
        ))}
      </div>

      <div class="grid min-h-[21rem] grid-cols-[2.25rem_minmax(0,1fr)] gap-2">
        <div class="mb-16 pt-8 text-xs text-zinc-500 dark:text-zinc-400">
          <div class="relative h-[16rem]">
            {liberoTicks.map((tick) => (
              <span
                class="absolute right-0 -translate-y-1/2"
                style={`top: ${((liberoMaxScore - tick) / liberoScoreRange) * 100}%`}
              >
                {tick}
              </span>
            ))}
          </div>
        </div>

        <div class="relative z-10 grid grid-cols-[repeat(18,minmax(1.6rem,1fr))] items-end gap-1.5 overflow-x-auto pb-1 pt-8">
          {
