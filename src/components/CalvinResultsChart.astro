---
type CalvinResult = {
  method: string;
  score: number;
  group: "baseline" | "ours";
  color: string;
  hoverColor: string;
};

const results: CalvinResult[] = [
  {
    method: "UniVLA",
    score: 3.801,
    group: "baseline",
    color: "#7895aa",
    hoverColor: "#98afc0",
  },
  {
    method: "pi0.5",
    score: 3.964,
    group: "baseline",
    color: "#6e8da4",
    hoverColor: "#8fa9bc",
  },
  {
    method: "OpenVLA-OFT",
    score: 4.279,
    group: "baseline",
    color: "#63849c",
    hoverColor: "#86a2b5",
  },
  {
    method: "X-VLA",
    score: 4.43,
    group: "baseline",
    color: "#587b95",
    hoverColor: "#7e9cb0",
  },
  {
    method: "FLOWER",
    score: 4.48,
    group: "baseline",
    color: "#4f728b",
    hoverColor: "#7593a8",
  },
  {
    method: "2D-JA",
    score: 4.195,
    group: "ours",
    color: "#8fb889",
    hoverColor: "#acd0a7",
  },
  {
    method: "GeomVLA-JA",
    score: 4.508,
    group: "ours",
    color: "#56a779",
    hoverColor: "#75c596",
  },
  {
    method: "GeomVLA w/o motion",
    score: 4.508,
    group: "ours",
    color: "#7fbf8f",
    hoverColor: "#9ed5ac",
  },
  {
    method: "GeomVLA",
    score: 4.624,
    group: "ours",
    color: "#329a68",
    hoverColor: "#54bd87",
  },
];

const minScore = 3.5;
const maxScore = 5;
const scoreRange = maxScore - minScore;
---

<section class="not-prose mx-auto max-w-3xl" data-calvin-results-chart>
  <div class="mb-5 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="m-0 font-mono text-xl font-semibold uppercase tracking-[0.12em] text-emerald-700 dark:text-emerald-300">
        CALVIN ABC_D
      </p>
    </div>
    <div class="flex flex-wrap gap-3 text-sm text-zinc-600 dark:text-zinc-300">
      <span class="inline-flex items-center gap-2">
        <span class="size-3 rounded-sm bg-[#5f829a]"></span>
        Baselines
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="size-3 rounded-sm bg-[#00c875]"></span>
        GeomVLA and variants
      </span>
    </div>
  </div>

  <div class="relative rounded-sm border border-zinc-200/80 bg-white/45 px-4 pb-4 pt-5 shadow-sm shadow-zinc-900/5 dark:border-zinc-800 dark:bg-zinc-900/25">
    <div class="pointer-events-none absolute inset-x-4 bottom-20 top-5">
      {[5, 4.5, 4, 3.5].map((tick) => (
        <span
          class="absolute inset-x-0 border-t border-zinc-200/80 dark:border-zinc-800"
          style={`top: ${((maxScore - tick) / scoreRange) * 100}%`}
        ></span>
      ))}
    </div>

    <div class="grid min-h-[22rem] grid-cols-[2rem_minmax(0,1fr)] gap-3">
      <div class="relative mb-16 text-xs text-zinc-500 dark:text-zinc-400">
        {[5, 4.5, 4, 3.5].map((tick) => (
          <span
            class="absolute right-0 -translate-y-1/2"
            style={`top: ${((maxScore - tick) / scoreRange) * 100}%`}
          >
            {tick.toFixed(1)}
          </span>
        ))}
      </div>

      <div class="relative z-10 grid grid-cols-9 items-end gap-2 md:gap-3">
        {
          results.map((result, index) => (
            <div
              class="flex h-full min-w-0 flex-col justify-end"
              style={`--score: ${result.score}; --min-score: ${minScore}; --score-range: ${scoreRange}; --bar-color: ${result.color}; --bar-hover-color: ${result.hoverColor}; --delay: ${index * 70}ms;`}
            >
              <div class="flex h-[18rem] items-end">
                <button
                  class="group calvin-result-bar relative w-full cursor-default rounded-t-sm bg-[var(--bar-color)] shadow-sm shadow-zinc-900/10 transition-colors duration-200 hover:bg-[var(--bar-hover-color)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
                  type="button"
                  aria-label={`${result.method}: ${result.score.toFixed(3)} out of 5 on CALVIN ABC-D`}
                  data-calvin-bar
                >
                  <span class="absolute -top-7 left-1/2 -translate-x-1/2 text-sm font-semibold text-zinc-800 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100 dark:text-zinc-100 md:opacity-100">
                    {result.score.toFixed(3)}
                  </span>
                </button>
              </div>
              <div class="mt-3 h-12 text-center text-[0.68rem] font-medium leading-tight text-zinc-700 dark:text-zinc-300 md:text-xs">
                {result.method}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <p class="mx-auto mt-3 max-w-3xl text-center text-sm leading-snug text-zinc-600 dark:text-zinc-300">
    Scores are average sequence lengths on CALVIN ABC_D, reported out of 5.
  </p>
</section>

<script>
  const setupCalvinResultsCharts = () => {
    document
      .querySelectorAll<HTMLElement>("[data-calvin-results-chart]")
      .forEach((chart) => {
        if (chart.dataset.ready === "true") return;
        chart.dataset.ready = "true";

        if (!("IntersectionObserver" in window)) {
          chart.dataset.visible = "true";
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              chart.dataset.visible = "true";
              observer.unobserve(chart);
            });
          },
          {
            rootMargin: "0px 0px -18% 0px",
            threshold: 0.25,
          },
        );

        observer.observe(chart);
      });
  };

  setupCalvinResultsCharts();
  document.addEventListener("astro:after-swap", setupCalvinResultsCharts);
</script>

<style>
  [data-calvin-bar] {
    height: calc((var(--score) - var(--min-score)) / var(--score-range) * 100%);
    transform: scaleY(0);
    transform-origin: bottom;
    transition:
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay),
      background-color 180ms ease;
  }

  [data-calvin-results-chart][data-visible="true"] [data-calvin-bar] {
    transform: scaleY(1);
  }
</style>
