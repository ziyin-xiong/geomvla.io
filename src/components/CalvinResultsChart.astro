const liberoTabs: { label: string; value: LiberoMetric }[] = [
  { label: "Average", value: "average" },
  { label: "Object", value: "object" },
  { label: "Spatial", value: "spatial" },
  { label: "Goal", value: "goal" },
  { label: "Long", value: "long" },
];
const liberoMinScore = 65;
const liberoMaxScore = 100;
const liberoScoreRange = liberoMaxScore - liberoMinScore;
const liberoTicks = [100, 90, 80, 70, 65];
const realWorldMaxScore = 70;
const realWorldTicks = [70, 50, 30, 10, 0];

const categoryOrder: Category[] = ["3d", "motion", "other", "ours"];
const categoryRank = (category: Category) => categoryOrder.indexOf(category);
const sortByCategoryThenScore = <T extends { category: Category; method: string }>(
  results: T[],
  scoreOf: (result: T) => number,
) =>
  [...results].sort((a, b) => {
    const categoryDelta = categoryRank(a.category) - categoryRank(b.category);
    if (categoryDelta !== 0) return categoryDelta;

    const scoreDelta = scoreOf(a) - scoreOf(b);
    if (scoreDelta !== 0) return scoreDelta;

    return a.method.localeCompare(b.method);
  });

const sortedLiberoMethods = sortByCategoryThenScore(
  liberoMethods,
  (result) => result.average,
);

topCharts.forEach((chart) => {
  chart.results = sortByCategoryThenScore(chart.results, (result) => result.score);
});
