                    >
                      <div class="flex h-[16rem] items-end">
                        <button
                          class="group result-bar relative w-full cursor-default rounded-t-[2px] bg-[var(--bar-color)] shadow-sm shadow-zinc-900/10 transition-colors duration-200 hover:bg-[var(--bar-hover-color)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
                          type="button"
