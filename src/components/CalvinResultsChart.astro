---
type Category = "3d" | "motion" | "other" | "ours";

type ChartResult = {
  method: string;
  score: number;
  category: Category;
  color: string;
  hoverColor: string;
};

type ResultChart = {
  id: string;
  title: string;
  ariaLabel: string;
  caption: string;
  minScore: number;
  maxScore: number;
  ticks: number[];
  digits: number;
  results: ChartResult[];
};

type LiberoMetric = "average" | "object" | "spatial" | "goal" | "long";

type LiberoMethod = {
  method: string;
  category: Category;
  color: string;
  hoverColor: string;
  spatial: number;
  object: number;
  goal: number;
  long: number | null;
  average: number;
};

type RealWorldCategory = "pi" | "ja" | "policy";

type RealWorldResult = {
  method: string;
  score: number;
  category: RealWorldCategory;
  color: string;
  hoverColor: string;
};

type RoboTwin50Task = {
  task: string;
  piEasy: number;
  piHard: number;
  geomEasy: number;
  geomHard: number;
};

