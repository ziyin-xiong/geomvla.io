<script>
  const setupResultsCharts = () => {
    const categoryOrder = {
      "3d": 0,
      motion: 1,
      other: 2,
      ours: 3,
    } as const;

    document
      .querySelectorAll<HTMLElement>("[data-results-charts]")
      .forEach((section) => {
        if (section.dataset.ready === "true") return;
        section.dataset.ready = "true";

        const reveal = () => {
          section.dataset.visible = "true";
        };

        if (!("IntersectionObserver" in window)) {
          reveal();
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                reveal();
                observer.unobserve(section);
              });
            },
            {
              rootMargin: "0px 0px -18% 0px",
              threshold: 0.25,
            },
          );

          observer.observe(section);
        }

        const tabs = Array.from(
          section.querySelectorAll<HTMLButtonElement>("[data-libero-tab]"),
        );
        const barWraps = Array.from(
          section.querySelectorAll<HTMLElement>("[data-libero-bar-wrap]"),
        );

        const selectLiberoMetric = (metric: string) => {
          tabs.forEach((tab) => {
            const isSelected = tab.dataset.liberoTab === metric;
            tab.setAttribute("aria-selected", String(isSelected));
            tab.classList.toggle("border-zinc-300", isSelected);
            tab.classList.toggle("bg-zinc-100", isSelected);
            tab.classList.toggle("text-zinc-950", isSelected);
            tab.classList.toggle("dark:border-zinc-600", isSelected);
            tab.classList.toggle("dark:bg-zinc-800", isSelected);
            tab.classList.toggle("dark:text-white", isSelected);
            tab.classList.toggle("border-transparent", !isSelected);
            tab.classList.toggle("bg-transparent", !isSelected);
            tab.classList.toggle("text-zinc-600", !isSelected);
            tab.classList.toggle("dark:text-zinc-400", !isSelected);
          });

          const sortedWraps = [...barWraps].sort((a, b) => {
            const categoryA =
              categoryOrder[a.dataset.category as keyof typeof categoryOrder] ?? 99;
            const categoryB =
              categoryOrder[b.dataset.category as keyof typeof categoryOrder] ?? 99;
            if (categoryA !== categoryB) return categoryA - categoryB;

            const valueA = a.dataset[metric] ?? a.dataset.average ?? "";
            const valueB = b.dataset[metric] ?? b.dataset.average ?? "";
            const scoreA = valueA === "" ? Number.NEGATIVE_INFINITY : Number(valueA);
            const scoreB = valueB === "" ? Number.NEGATIVE_INFINITY : Number(valueB);
            if (scoreA !== scoreB) return scoreA - scoreB;

            return (a.dataset.method ?? "").localeCompare(b.dataset.method ?? "");
          });

          sortedWraps.forEach((wrap, order) => {
            wrap.style.order = String(order);
          });

          barWraps.forEach((wrap) => {
            const rawScore = wrap.dataset[metric] ?? wrap.dataset.average ?? "";
            const hasScore = rawScore !== "";
            const score = hasScore ? rawScore : "65";
            const bar = wrap.querySelector<HTMLButtonElement>("[data-libero-bar]");
            const label = bar?.querySelector("span");
            wrap.style.setProperty("--score", score);
            if (bar) {
              const method = wrap.dataset.method || "method";
              bar.setAttribute(
                "aria-label",
                hasScore
                  ? `${method}: ${Number(score).toFixed(1)} on LIBERO ${metric}`
                  : `${method}: not reported on LIBERO ${metric}`,
              );
            }
            if (label) label.textContent = hasScore ? Number(score).toFixed(1) : "--";
          });
        };

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            if (tab.dataset.liberoTab) selectLiberoMetric(tab.dataset.liberoTab);
          });
        });
      });
  };

  setupResultsCharts();
  document.addEventListener("astro:after-swap", setupResultsCharts);
</script>

