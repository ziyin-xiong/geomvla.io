---

<section class="not-prose mx-auto max-w-6xl" data-calvin-results-chart>
  <div class="mb-5 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <p class="m-0 font-mono text-xl font-semibold uppercase tracking-[0.12em] text-emerald-700 dark:text-emerald-300">
      Simulation Results
    </p>
    <div class="flex flex-wrap gap-3 text-sm text-zinc-600 dark:text-zinc-300">
      <span class="inline-flex items-center gap-2">
        <span class="size-3 rounded-[3px] bg-[#5f829a]"></span>
        Baselines
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="size-3 rounded-[3px] bg-[#329a68]"></span>
        GeomVLA and variants
      </span>
    </div>
  </div>

  <div class="grid gap-7 lg:grid-cols-2">
    {
      charts.map((chart) => {
        const scoreRange = chart.maxScore - chart.minScore;
        return (
          <article>
            <h3 class="mb-3 text-center font-mono text-lg font-semibold uppercase tracking-[0.1em] text-emerald-700 dark:text-emerald-300">
              {chart.title}
            </h3>

            <div class="relative rounded-sm border border-zinc-200/80 bg-white/45 px-3 pb-4 pt-5 shadow-sm shadow-zinc-900/5 dark:border-zinc-800 dark:bg-zinc-900/25">
              <div class="pointer-events-none absolute inset-x-3 bottom-20 top-5">
                {chart.ticks.map((tick) => (
                  <span
                    class="absolute inset-x-0 border-t border-zinc-200/80 dark:border-zinc-800"
                    style={`top: ${((chart.maxScore - tick) / scoreRange) * 100}%`}
                  ></span>
                ))}
              </div>

              <div class="grid min-h-[20rem] grid-cols-[2.25rem_minmax(0,1fr)] gap-2">
                <div class="relative mb-16 text-xs text-zinc-500 dark:text-zinc-400">
                  {chart.ticks.map((tick) => (
                    <span
                      class="absolute right-0 -translate-y-1/2"
                      style={`top: ${((chart.maxScore - tick) / scoreRange) * 100}%`}
                    >
                      {tick.toFixed(chart.digits === 3 ? 1 : 0)}
                    </span>
                  ))}
                </div>

                <div class="relative z-10 grid grid-cols-9 items-end gap-1.5 md:gap-2">
                  {chart.results.map((result, index) => (
                    <div
                      class="flex h-full min-w-0 flex-col justify-end"
                      style={`--score: ${result.score}; --min-score: ${chart.minScore}; --score-range: ${scoreRange}; --bar-color: ${result.color}; --bar-hover-color: ${result.hoverColor}; --delay: ${index * 70}ms;`}
                    >
                      <div class="flex h-[16rem] items-end">
                        <button
                          class="group calvin-result-bar relative w-full cursor-default rounded-t-sm bg-[var(--bar-color)] shadow-sm shadow-zinc-900/10 transition-colors duration-200 hover:bg-[var(--bar-hover-color)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
                          type="button"
                          aria-label={`${result.method}: ${result.score.toFixed(chart.digits)} on ${chart.ariaLabel}`}
                          data-calvin-bar
                        >
                          <span class="absolute -top-7 left-1/2 -translate-x-1/2 text-xs font-semibold text-zinc-800 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100 dark:text-zinc-100 md:opacity-100">
                            {result.score.toFixed(chart.digits)}
                          </span>
                        </button>
                      </div>
                      <div class="mt-3 h-12 text-center text-[0.62rem] font-medium leading-tight text-zinc-700 dark:text-zinc-300 md:text-[0.68rem]">
                        {result.method}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <p class="mx-auto mt-3 max-w-lg text-center text-sm leading-snug text-zinc-600 dark:text-zinc-300">
              {chart.caption}
            </p>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  const setupCalvinResultsCharts = () => {
    document
      .querySelectorAll<HTMLElement>("[data-calvin-results-chart]")
      .forEach((chart) => {
        if (chart.dataset.ready === "true") return;
        chart.dataset.ready = "true";

        if (!("IntersectionObserver" in window)) {
          chart.dataset.visible = "true";
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              chart.dataset.visible = "true";
              observer.unobserve(chart);
            });
          },
          {
            rootMargin: "0px 0px -18% 0px",
            threshold: 0.25,
          },
        );

        observer.observe(chart);
      });
  };

  setupCalvinResultsCharts();
  document.addEventListener("astro:after-swap", setupCalvinResultsCharts);
</script>

<style>
  [data-calvin-bar] {
    height: calc((var(--score) - var(--min-score)) / var(--score-range) * 100%);
    transform: scaleY(0);
    transform-origin: bottom;
    transition:
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay),
      background-color 180ms ease;
  }

  [data-calvin-results-chart][data-visible="true"] [data-calvin-bar] {
    transform: scaleY(1);
  }
</style>
