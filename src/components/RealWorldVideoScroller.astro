---
type RealWorldVideo = {
  label: string;
  src: string;
};

interface Props {
  videos: RealWorldVideo[];
}

const { videos } = Astro.props;
const repeatedVideos = [...videos, ...videos];
---

<section class="not-prose" data-real-world-scroller>
  <div class="overflow-x-auto overflow-y-hidden pb-1 [scrollbar-width:thin]" data-real-world-scrollport>
    <div class="flex w-max gap-4 pb-3" data-real-world-track>
      {
        repeatedVideos.map((video) => (
          <figure
            class="m-0 shrink-0 space-y-2"
            data-real-world-item
          >
            <div class="aspect-video overflow-hidden rounded-sm bg-zinc-950">
              <video
                data-real-world-video
                class="h-full w-full object-cover"
                src={video.src}
                controls
                loop
                muted
                playsinline
                autoplay
                preload="metadata"
              ></video>
            </div>
            <figcaption class="text-center text-base leading-snug text-zinc-700 dark:text-zinc-300">
              {video.label}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  const setupRealWorldScrollers = () => {
    document
      .querySelectorAll<HTMLElement>("[data-real-world-scroller]")
      .forEach((scroller) => {
        if (scroller.dataset.ready === "true") return;
        scroller.dataset.ready = "true";

        const scrollport = scroller.querySelector<HTMLElement>(
          "[data-real-world-scrollport]",
        );
        const track = scroller.querySelector<HTMLElement>("[data-real-world-track]");
        const videos = Array.from(
          scroller.querySelectorAll<HTMLVideoElement>("[data-real-world-video]"),
        );
        let resumeTimer: number | undefined;

        const syncPlayback = () => {
          videos.forEach((video) => video.play().catch(() => {}));
        };

        const pauseMarquee = () => {
          if (!track) return;
          track.dataset.paused = "true";
          if (resumeTimer) window.clearTimeout(resumeTimer);
          resumeTimer = window.setTimeout(() => {
            track.dataset.paused = "false";
          }, 300);
        };

        scrollport?.addEventListener("scroll", pauseMarquee, { passive: true });
        scrollport?.addEventListener("pointerdown", pauseMarquee);
        scrollport?.addEventListener("wheel", pauseMarquee, { passive: true });
        scrollport?.addEventListener("touchstart", pauseMarquee, { passive: true });

        syncPlayback();

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            videos.forEach((video) => video.pause());
          } else {
            syncPlayback();
          }
        });
      });
  };

  setupRealWorldScrollers();
  document.addEventListener("astro:after-swap", setupRealWorldScrollers);
</script>

<style>
  [data-real-world-track] {
    animation: real-world-marquee 54s linear infinite;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  [data-real-world-scroller]:hover [data-real-world-track],
  [data-real-world-scroller]:focus-within [data-real-world-track],
  [data-real-world-track][data-paused="true"] {
    animation-play-state: paused;
  }

  [data-real-world-item] {
    width: min(34rem, calc((min(64rem, 100vw - 3rem) - 1rem) / 2));
  }

  @keyframes real-world-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(calc(-50% - 0.5rem), 0, 0);
    }
  }

  @media (max-width: 720px) {
    [data-real-world-item] {
      width: calc(100vw - 3rem);
      min-width: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-real-world-track] {
      animation: none;
    }
  }
</style>
