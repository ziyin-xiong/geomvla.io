---
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";

type OutlineLink = {
  label: string;
  href: string;
};

type ActionLink = OutlineLink & {
  detail?: string;
};

interface Props {
  logo: ImageMetadata | string;
  links: OutlineLink[];
  summary: string;
  actions: ActionLink[];
}

const { logo, links, summary, actions } = Astro.props;
const logoSrc = typeof logo === "string" ? logo : logo.src;
---

<nav
  class="not-prose full-bleed sticky top-0 z-50 -mt-16 overflow-x-auto border-b border-zinc-300/80 bg-[#f7f8f4]/90 backdrop-blur-md [scrollbar-width:none] dark:border-zinc-800 dark:bg-zinc-950/90 [&::-webkit-scrollbar]:hidden"
  aria-label="Page navigation"
  data-section-nav
  data-over-hero="true"
>
  <div class="mx-auto flex h-22 w-max max-w-[92rem] items-center gap-5 px-7">
    <a class="flex shrink-0 items-center hover:no-underline" href="#top" aria-label="GeomVLA">
      <img class="geomvla-nav-logo m-0 h-18 w-auto max-w-64 translate-y-1.5 object-contain shadow-none" src={logoSrc} alt="GeomVLA" />
    </a>
    <span
      class="hidden max-w-[34rem] truncate border-l border-zinc-300 pl-5 text-sm text-emerald-700 opacity-0 transition-opacity duration-300 dark:border-zinc-700 dark:text-emerald-300 lg:block"
      data-section-summary
    >
      {summary}
    </span>
    <div class="ml-auto flex items-center gap-1">
      {
        actions.map((link) => (
            <a
              class="rounded px-2.5 py-1.5 text-sm font-medium whitespace-nowrap text-zinc-600 no-underline transition hover:bg-zinc-900/5 hover:text-emerald-800 dark:text-zinc-300 dark:hover:bg-white/10 dark:hover:text-emerald-300"
              href={link.href}
            >
              {link.label}
              {link.detail && <em class="ml-1 rounded-full border border-zinc-300 px-1.5 py-0.5 text-[0.62rem] not-italic uppercase tracking-[0.08em] text-zinc-400">{link.detail}</em>}
            </a>
        ))
      }
      <button
        class="inline-grid size-8 place-items-center rounded border border-zinc-300/80 bg-white/50 text-zinc-600 transition hover:bg-zinc-900/5 hover:text-emerald-800 dark:border-zinc-700 dark:bg-zinc-900/60 dark:text-zinc-300 dark:hover:bg-white/10 dark:hover:text-emerald-300"
        type="button"
        aria-label="Switch to night version"
        title="Switch to night version"
        data-theme-toggle
      >
        <span data-theme-icon="moon">
          <Icon class="size-4" name="ri:moon-line" />
        </span>
        <span data-theme-icon="sun" hidden>
          <Icon class="size-4" name="ri:sun-line" />
        </span>
      </button>
    </div>
  </div>
</nav>

<aside class="not-prose fixed top-28 z-40 max-h-[calc(100vh-9rem)] w-44 overflow-y-auto border-l border-zinc-300/80 pl-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label="On this page" data-section-rail data-over-hero="true">
  <nav class="grid gap-0.5">
    {
      links.map((link) => (
        <a
          class="relative py-1.5 pl-0 text-[0.82rem] leading-snug text-zinc-500 no-underline transition before:absolute before:-left-4 before:top-1/2 before:h-0 before:w-0.5 before:-translate-y-1/2 before:bg-zinc-400 before:transition-all hover:text-zinc-900 hover:before:h-4 aria-[current=true]:text-zinc-950 aria-[current=true]:before:h-5 aria-[current=true]:before:bg-emerald-700 dark:text-zinc-400 dark:hover:text-white dark:aria-[current=true]:text-white dark:aria-[current=true]:before:bg-emerald-300"
          href={link.href}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</aside>

<script>
  const setupSectionOutline = () => {
    const railLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        "[data-section-rail] a[href^='#']",
      ),
    );
    const topNav = document.querySelector<HTMLElement>("[data-section-nav]");
    const rail = document.querySelector<HTMLElement>("[data-section-rail]");
    const summary = document.querySelector<HTMLElement>("[data-section-summary]");
    const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const revealTargets = Array.from(
      document.querySelectorAll<HTMLElement>(
        "main > :not([data-section-nav]):not([data-section-rail]):not(script):not(style)",
      ),
    ).filter((target) => target.children.length > 0 || target.textContent?.trim());

    const targets = railLinks
      .map((link) => document.querySelector<HTMLElement>(link.hash))
      .filter((target): target is HTMLElement => Boolean(target));
    let lockedCurrentId: string | null = null;
    let releaseLockTimer: number | undefined;

    const setCurrent = (id: string) => {
      railLinks.forEach((link) => {
        if (link.hash === `#${id}`) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const getAnchorOffset = () => {
      const navHeight = topNav?.getBoundingClientRect().height ?? 88;
      return Math.round(navHeight + 32);
    };

    const syncCurrent = () => {
      const offset = getAnchorOffset() + 12;
      const hasScrolled = window.scrollY > 180;

      if (topNav) {
        topNav.dataset.overHero = hasScrolled ? "false" : "true";
      }

      if (rail) {
        rail.dataset.overHero = hasScrolled ? "false" : "true";
      }

      if (summary) {
        summary.classList.toggle("opacity-0", !hasScrolled);
        summary.classList.toggle("opacity-100", hasScrolled);
      }

      if (targets.length === 0) return;

      if (lockedCurrentId) {
        setCurrent(lockedCurrentId);
        return;
      }

      const current =
        targets
          .filter((target) => target.getBoundingClientRect().top <= offset)
          .at(-1) ?? targets[0];

      setCurrent(current.id);
    };

    if (themeToggle && themeToggle.dataset.ready !== "true") {
      themeToggle.dataset.ready = "true";
      const sunIcon = themeToggle.querySelector<HTMLElement>("[data-theme-icon='sun']");
      const moonIcon = themeToggle.querySelector<HTMLElement>("[data-theme-icon='moon']");

      const applyTheme = (theme: "light" | "dark") => {
        document.documentElement.dataset.theme = theme;
        themeToggle.setAttribute(
          "aria-label",
          theme === "dark" ? "Switch to day version" : "Switch to night version",
        );
        themeToggle.setAttribute(
          "title",
          theme === "dark" ? "Switch to day version" : "Switch to night version",
        );
        if (sunIcon) sunIcon.hidden = theme !== "dark";
        if (moonIcon) moonIcon.hidden = theme === "dark";
        localStorage.setItem("geomvla-theme", theme);
      };

      const savedTheme = localStorage.getItem("geomvla-theme");
      if (savedTheme === "light" || savedTheme === "dark") {
        applyTheme(savedTheme);
      }

      themeToggle.addEventListener("click", () => {
        const currentTheme =
          document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        applyTheme(currentTheme === "dark" ? "light" : "dark");
      });
    }

    railLinks.forEach((link) => {
      if (link.dataset.ready === "true") return;
      link.dataset.ready = "true";
      link.addEventListener("click", (event) => {
        const id = link.hash.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!id || !target) return;

        event.preventDefault();
        lockedCurrentId = id;
        if (releaseLockTimer) window.clearTimeout(releaseLockTimer);
        setCurrent(id);
        history.pushState(null, "", `#${id}`);
        window.scrollTo({
          top: Math.max(0, target.getBoundingClientRect().top + window.scrollY - getAnchorOffset()),
          behavior: "smooth",
        });
        releaseLockTimer = window.setTimeout(() => {
          lockedCurrentId = null;
          syncCurrent();
        }, 900);
      });
    });

    revealTargets.forEach((target) => target.classList.add("reveal-on-scroll"));

    if ("IntersectionObserver" in window) {
      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        {
          rootMargin: "0px 0px -8% 0px",
          threshold: 0.12,
        },
      );

      revealTargets.forEach((target) => revealObserver.observe(target));
    } else {
      revealTargets.forEach((target) => target.classList.add("is-visible"));
    }

    syncCurrent();
    document.addEventListener("scroll", syncCurrent, { passive: true });
  };

  setupSectionOutline();
  document.addEventListener("astro:after-swap", setupSectionOutline);
</script>

<style>
  [data-section-rail] {
    display: none;
    transition: opacity 0.3s ease;
  }

  @media (min-width: 1420px) {
    [data-section-rail] {
      display: block;
      left: max(1.25rem, calc((100vw - 72rem) / 2 - 12.5rem));
    }
  }

  [data-section-rail][data-over-hero="true"] {
    opacity: 0;
    pointer-events: none;
  }

  .geomvla-nav-logo {
    box-shadow: none !important;
    background: transparent;
  }

  :global(:root[data-theme="dark"]) .geomvla-nav-logo {
    filter: brightness(0) saturate(100%) invert(85%) sepia(55%) saturate(571%)
      hue-rotate(83deg) brightness(94%) contrast(90%);
  }
</style>
